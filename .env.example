# ─── FloraCycle Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Django Core ───────────────────────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-this-in-production-use-50-chars-minimum
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app-name.onrender.com

# ── CSRF (required for login and forms to work on HTTPS / Render) ─────────────
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com

# ── Database ──────────────────────────────────────────────────────────────────
# Leave DB_NAME blank to use SQLite (local dev only).
# Fill all five variables to use PostgreSQL (production on Render).
DB_NAME=floracycle
DB_USER=floracycle_user
DB_PASSWORD=your_strong_password_here
DB_HOST=your-render-postgres-host.render.com
DB_PORT=5432

# ── JWT Token Lifetimes ────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-app-name.onrender.com,http://localhost:8000

# ── Media ─────────────────────────────────────────────────────────────────────
MEDIA_URL=/media/

# ── Email (optional) ──────────────────────────────────────────────────────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=FloraCycle <your@gmail.com>

# ─── Render Deployment Checklist ──────────────────────────────────────────────
#
#  1. Create a new Web Service on Render, connect your GitHub repo.
#
#  2. Set these environment variables in Render → Environment panel:
#       SECRET_KEY, DEBUG=False, ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS
#       DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, DB_PORT
#       CORS_ALLOWED_ORIGINS
#
#  3. Build Command:
#       pip install -r requirements.txt && python manage.py collectstatic --noinput && python manage.py migrate
#
#  4. Start Command:
#       gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --timeout 120
#
#  5. After first deploy, open the Render shell and run:
#       python manage.py createsuperuser
#
#  6. (If upgrading from older version) Remove demo user:
#       python manage.py remove_demo_users
