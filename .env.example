# ==============================================================================
# FloraCycle Environment Variables
# ==============================================================================
# Copy this file to .env and replace the placeholder values with real values.
# NEVER commit the .env file containing real secrets to GitHub.
#
# This file is only a template.
# ==============================================================================


# ==============================================================================
# Django Core
# ==============================================================================

# Generate a strong secret key for production.
SECRET_KEY=replace-with-a-secure-secret-key

# Use False for production.
DEBUG=False

# Comma-separated list of allowed hosts.
ALLOWED_HOSTS=localhost,127.0.0.1,floracycleproject.onrender.com

# Allowed HTTPS origins for CSRF protection.
CSRF_TRUSTED_ORIGINS=https://floracycleproject.onrender.com,http://localhost:8000,http://127.0.0.1:8000


# ==============================================================================
# PostgreSQL Database
# ==============================================================================

# For Docker Compose:
# DB_HOST=db
#
# For Render:
# DB_HOST=your-render-postgresql-host

DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=5432


# ==============================================================================
# JWT Authentication
# ==============================================================================

ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7


# ==============================================================================
# CORS
# ==============================================================================

# Frontend origins allowed to access the Django API.
CORS_ALLOWED_ORIGINS=https://floracycleproject.onrender.com,http://localhost:8000,http://127.0.0.1:8000


# ==============================================================================
# Media Files
# ==============================================================================

MEDIA_URL=/media/


# ==============================================================================
# Email Configuration
# ==============================================================================

# Uncomment and configure these only when email functionality is required.

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_gmail_app_password
# DEFAULT_FROM_EMAIL=FloraCycle <your_email@gmail.com>


# ==============================================================================
# Render Deployment
# ==============================================================================
#
# Configure the following variables in:
#
# Render
#   → Web Service
#   → Environment
#
# Required variables:
#
# SECRET_KEY
# DEBUG
# ALLOWED_HOSTS
# CSRF_TRUSTED_ORIGINS
# DB_NAME
# DB_USER
# DB_PASSWORD
# DB_HOST
# DB_PORT
# CORS_ALLOWED_ORIGINS
#
# Build Command:
#
# pip install -r requirements.txt && python manage.py collectstatic --noinput && python manage.py migrate
#
# Start Command:
#
# gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --timeout 120
#
# After deployment:
#
# python manage.py createsuperuser
#
# ==============================================================================
